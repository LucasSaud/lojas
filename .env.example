# Copie para .env e preencha. O .env não entra no git.

# Domínio principal, sem protocolo (ex.: seudominio.com.br). Lojas ficam em <loja>.APP_DOMAIN
APP_DOMAIN=localhost:8080

# 1 em produção (força HTTPS); 0 em desenvolvimento
APP_HTTPS=0

# Banco de dados
DB_HOST=db
DB_USER=multiloja
DB_PASS=
DB_NAME=multiloja
DB_ROOT_PASS=

# E-mail de envio. O servidor usado é mail.<domínio de SMTP_USER>, porta 587
SMTP_NAME=WorldShop
SMTP_USER=
SMTP_PASS=

# Google reCAPTCHA
RECAPTCHA_SITEKEY=
RECAPTCHA_SECRETKEY=

# Token do cron e dos callbacks de pagamento. Gere um valor novo e longo
EXTERNAL_TOKEN=

# Mercado Pago (cobrança dos planos)
MP_SANDBOX=0
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# Notificações push (par VAPID). Gere um par novo; a pública também vai em app/main.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Chave que cifra as credenciais de pagamento das lojas no banco (32 bytes em base64).
# Gere com: php -r 'echo base64_encode(random_bytes(32));'   Guarde em backup: sem ela as credenciais se perdem.
APP_KEY=

# Google Places API (tela Captar da administração). Opcional.
GOOGLE_PLACES_KEY=
