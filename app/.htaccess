RewriteEngine On
RewriteBase /
# conheca.APP_DOMAIN -> página institucional em /conheca/
RewriteCond %{HTTP_HOST} ^conheca\. [NC]
RewriteCond %{REQUEST_URI} !^/conheca/
RewriteRule (.*) conheca/$1 [L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
# <loja>.APP_DOMAIN -> index.php?insubdominio=<loja>
RewriteCond %{HTTP_HOST}#%{ENV:APP_DOMAIN} ^([a-z0-9-]+)\.(.+)#\2$ [NC]
RewriteRule (.*) index.php?insubdominio=%1&inrouter=$1 [NC,L,QSA]
ErrorDocument 404 /404.php
